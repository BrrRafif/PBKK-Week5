<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="F-Electics Student Management System"
    Width="1200"
    Height="780"
    MinWidth="1000"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="#FFFDF7"
    Language="id-ID">

    <Window.Resources>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#3F3210"/>
            <Setter Property="Background" Value="#DDB862"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5A4719"/>
            <Setter Property="BorderBrush" Value="#EADBB2"/>
        </Style>

        <Style x:Key="RowEditButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowEditButton}">
            <Setter Property="Background" Value="#D9534F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EADBB2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A13E"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#EADBB2"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A4719"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,0,10"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EFE2BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FBF5E4"/>
            <Setter Property="Foreground" Value="#5A4719"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#EFE2BE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F6E7B8"/>
                    <Setter Property="Foreground" Value="#3F3210"/>
                    <Setter Property="BorderBrush" Value="#F6E7B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#E8CF8E"
            CornerRadius="10"
            Padding="20"
            Margin="0,0,0,15">

            <Grid>
                <StackPanel>
                    <TextBlock
                        Text="F-ELECTICS STUDENT MANAGEMENT SYSTEM"
                        Foreground="#4A3A14"
                        FontSize="28"
                        FontWeight="Bold"/>
                    
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dddd, dd MMMM yyyy'}"
                        Foreground="#4A3A14"
                        FontSize="13"
                        FontWeight="DemiBold"
                        HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock
                            Text="✎ INPUT MAHASISWA"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#5A4719"/>
                        <TextBlock
                            Text="{Binding FormModeText}"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="#7A6A42"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock
                        Text="Semua kolom bertanda * wajib diisi."
                        FontSize="12"
                        Foreground="#7A6A42"
                        Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="NRP *" Style="{StaticResource LabelText}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" MaxLength="20"
                            Text="{Binding FormStudent.NRP,
                                   UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="Nama *" Style="{StaticResource LabelText}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" MaxLength="100"
                            Text="{Binding FormStudent.Nama,
                                   UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Departemen *" Style="{StaticResource LabelText}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                            SelectedValuePath="Content"
                            SelectedValue="{Binding FormStudent.Jurusan, Mode=TwoWay}">
                            <ComboBoxItem>Teknik Informatika</ComboBoxItem>
                            <ComboBoxItem>Teknik Elektro</ComboBoxItem>
                            <ComboBoxItem>Teknik Biomedik</ComboBoxItem>
                            <ComboBoxItem>Teknik Komputer</ComboBoxItem>
                            <ComboBoxItem>Teknologi Informasi</ComboBoxItem>
                            <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Text="Gender *" Style="{StaticResource LabelText}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1"
                            SelectedValuePath="Content"
                            SelectedValue="{Binding FormStudent.Gender, Mode=TwoWay}">
                            <ComboBoxItem>Laki-laki</ComboBoxItem>
                            <ComboBoxItem>Perempuan</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Text="Email *" Style="{StaticResource LabelText}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" MaxLength="100"
                            Text="{Binding FormStudent.Email,
                                   UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="#C62828"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Margin="90,0,0,0"/>
                    <TextBlock
                        Text="{Binding SuccessMessage}"
                        Foreground="#2E7D32"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Margin="90,0,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="90,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                MinWidth="130">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;"/>
                                <TextBlock Text="{Binding SaveButtonText}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetCommand}"
                                MinWidth="130"
                                ToolTip="Kosongkan form">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                                <TextBlock Text="Reset"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Background="#FBF5E4"
                BorderBrush="#EFE2BE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="▥ INFORMASI"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#5A4719"
                        Margin="0,0,0,8"/>

                    <UniformGrid Grid.Row="1" Columns="3">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Total Mahasiswa" FontSize="12"/>
                                <TextBlock
                                    Text="{Binding TotalStudents}"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#4A3A14"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#C9A13E"/>
                                    <Run Text=" Laki-laki"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalLakiLaki}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#B5835A"/>
                                    <Run Text=" Perempuan"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalPerempuan}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock
                        Grid.Row="2"
                        Text="Per Departemen"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#5A4719"
                        Margin="4,8,0,0"/>

                    <UniformGrid Grid.Row="3" Columns="3">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#D4A72C"/>
                                    <Run Text=" Teknik Informatika"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalTeknikInformatika}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#C08B2E"/>
                                    <Run Text=" Teknik Elektro"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalTeknikElektro}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#B8763A"/>
                                    <Run Text=" Teknik Biomedik"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalTeknikBiomedik}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#A9894B"/>
                                    <Run Text=" Teknik Komputer"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalTeknikKomputer}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#8C7A3E"/>
                                    <Run Text=" Teknologi Informasi"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalTeknologiInformasi}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="●" Foreground="#6E5A28"/>
                                    <Run Text=" Sistem Informasi"/>
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding TotalSistemInformasi}"
                                    FontSize="22"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="#A88532"/>
                    <TextBlock Text="Search" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <TextBox
                        x:Name="SearchBox"
                        Margin="0"
                        Text="{Binding SearchText,
                               UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Text="Cari berdasarkan NRP, Nama, Departemen, atau Email..."
                        Foreground="#B3A47E"
                        FontSize="13"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"
                        Padding="22,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;"/>
                        <TextBlock Text="Cari"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetSearchCommand}"
                        Padding="22,8"
                        Margin="0"
                        ToolTip="Tampilkan semua data">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                        <TextBlock Text="Reset"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid
                ItemsSource="{Binding Students}"
                SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#F3EAD0"
                BorderThickness="0"
                RowHeight="40"
                FontSize="13">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="NRP"
                                        Binding="{Binding NRP}" Width="100"/>
                    <DataGridTextColumn Header="Nama"
                                        Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Departemen"
                                        Binding="{Binding Jurusan}" Width="150"/>
                    <DataGridTextColumn Header="Gender"
                                        Binding="{Binding Gender}" Width="110"/>
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}" Width="*"/>

                    <DataGridTemplateColumn Header="Aksi" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button
                                        Content="Edit"
                                        Style="{StaticResource RowEditButton}"
                                        Command="{Binding DataContext.EditRowCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                    <Button
                                        Content="Hapus"
                                        Style="{StaticResource RowDeleteButton}"
                                        Command="{Binding DataContext.DeleteRowCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>